{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab.rappor.com/schemas/public-external-baseline.schema.json",
  "title": "Rappor Security external public observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "benchmarkVersion",
    "recordedAt",
    "disposition",
    "application",
    "execution",
    "sources",
    "observations"
  ],
  "properties": {
    "$schema": { "const": "../../schemas/public-external-baseline.schema.json" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "benchmarkVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "disposition": { "const": "informational" },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl", "publicFlow", "selectedVisibleVersion"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "publicFlow": { "const": "/" },
        "selectedVisibleVersion": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "scope", "authenticated", "activeTesting", "profile", "rulesetDigest"],
      "properties": {
        "interface": { "const": "public-browser-form" },
        "scope": { "const": "passive" },
        "authenticated": { "const": false },
        "activeTesting": { "const": false },
        "profile": { "type": "string", "minLength": 1 },
        "rulesetDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operator", "purpose", "evidenceUrl", "evidenceRevision"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "operator": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "evidenceUrl": { "type": "string", "format": "uri" },
        "evidenceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "severity", "confidence", "category"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "confidence": { "enum": ["low", "moderate", "high"] },
        "category": { "type": "string", "minLength": 1 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "operatorSourceId",
        "url",
        "observedAt",
        "visibleVersion",
        "externalState",
        "status",
        "summary",
        "findingCount",
        "highOrCriticalCount",
        "findings",
        "externalObservation"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "scenario": { "enum": ["mixed-content", "missing-hsts", "insecure-cookie", "expired-certificate"] },
        "operatorSourceId": { "$ref": "#/$defs/identifier" },
        "url": { "type": "string", "format": "uri" },
        "observedAt": { "type": "string", "format": "date-time" },
        "visibleVersion": { "type": "string", "minLength": 1 },
        "externalState": { "enum": ["available", "changed", "unavailable"] },
        "status": { "enum": ["completed", "partial", "failed"] },
        "summary": { "type": "string", "minLength": 1 },
        "findingCount": { "type": "integer", "minimum": 0 },
        "highOrCriticalCount": { "type": "integer", "minimum": 0 },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "externalObservation": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
